{
    "name": "backend",
    "version": "1.0.0",
    "description": "API backend de gestion des candidats",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",

        "test": "jest --config jest.config.cjs --runInBand --coverage",
        "test:unit": "jest --config jest.config.cjs --runInBand --coverage --selectProjects unit",
        "test:integration": "jest --config jest.config.cjs --runInBand --selectProjects integration",

        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",

        "prepare": "husky"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.6.2",
        "multer": "^2.1.1",
        "pino": "^10.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.2",
        "typescript": "^6.0.3",
        "ts-node-dev": "^2.0.0",
        "jest": "^30.2.0",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5"
    }
}