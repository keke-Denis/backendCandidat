{
    "name": "backend",
    "version": "1.0.0",
    "description": "API backend de gestion des candidats",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",

        "test": "jest --config jest.config.cjs --runInBand --coverage",
        "test:unit": "jest --config jest.config.cjs --runInBand --coverage --selectProjects unit",
        "test:integration": "jest --config jest.config.cjs --runInBand --selectProjects integration",

        "load:test": "artillery run load-test.yml --output load-test-report.json",
        "test:changed": "jest --findRelatedTests",

        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",

        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",

        "prepare": ""
    },
    "lint-staged": {
        "*.{ts,js,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.ts": [
            "eslint --fix"
        ]
    }
}