{
    "name": "backend",
    "version": "1.0.0",
    "description": "API backend de gestion des candidats",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "test": "jest --config jest.config.cjs --runInBand --coverage",
        "test:unit": "jest --config jest.config.cjs --runInBand --coverage --selectProjects unit",
        "test:integration": "jest --config jest.config.cjs --runInBand --selectProjects integration",
        "load:test": "artillery run load-test.yml --output load-test-report.json",
        "test:changed": "jest --findRelatedTests",
        "lint": "eslint . --ext .ts",
        "lint:fix": "eslint . --ext .ts --fix",
        "format": "prettier . --write",
        "typecheck": "tsc --noEmit",
        "prepare": ""
    },
    "keywords": [
        "nodejs",
        "express",
        "typescript",
        "mongodb",
        "candidates"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.6.2",
        "multer": "^2.1.1",
        "pino": "^10.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^9.38.0",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.1.0",
        "@types/node": "^25.6.2",
        "@types/semver": "^7.7.1",
        "@types/supertest": "^6.0.3",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "artillery": "^2.0.0-31",
        "eslint": "^9.38.0",
        "globals": "^16.4.0",
        "husky": "^9.1.7",
        "jest": "^30.2.0",
        "lint-staged": "^16.2.6",
        "mongodb-memory-server": "^10.2.3",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.5",
        "ts-node-dev": "^2.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.46.2"
    },
    "engines": {
        "node": "20.x"
    },
    "lint-staged": {
        "*.{ts,js,json,md,yml,yaml}": [
            "prettier --write"
        ],
        "*.ts": [
            "eslint --fix"
        ]
    }
}
